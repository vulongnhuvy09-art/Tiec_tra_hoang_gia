# Saint Vance Game - Environment Variables
# Copy file này thành .env.local và điền thông tin

# ============================================
# GEMINI API KEY (Bắt buộc)
# ============================================
# 1. Vào https://ai.google.dev/
# 2. Login bằng tài khoản Google có Gemini Pro
# 3. Click "Get API Key"
# 4. Copy API key
# 5. Paste vào dòng dưới:

VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Optional: Backend URL (nếu sau có backend)
# ============================================
# VITE_BACKEND_URL=http://localhost:3000

# ============================================
# Optional: Google OAuth (nếu sau có OAuth)
# ============================================
# VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
